{
  "manifest_version": 3,
  "name": "GTA6 Blocker",
  "version": "1.4",
  "description": "Blendet GTA-6-Inhalte und -Kategorien auf YouTube, Twitch, Instagram und TikTok aus. Jederzeit ein-/ausschaltbar.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTA6 Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gta6-blocker@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}